{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Personal portfolio for Sriram Nuthi, versioned across v1, v2, and v3",
  "scripts": {
    "deploy:live": "firebase deploy --only hosting:live",
    "deploy:v1": "firebase deploy --only hosting:v1",
    "deploy:v2": "firebase deploy --only hosting:v2",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "firebase-tools": "^15.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2"
  }
}
