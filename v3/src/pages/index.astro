---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProofStrip from '../components/ProofStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import Timeline from '../components/Timeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import metrics from '../data/metrics.json';
import experience from '../data/experience.json';
import recognition from '../data/recognition.json';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const publicationCount = recognition.publications.length;
---

<Base
  title="Sriram Nuthi — Backend & Distributed Systems Engineer"
  description="Associate Software Engineer at Veeva Systems, working on archival storage, message queues, and document integration at enterprise scale."
>
  <Nav slot="nav" />
  <Footer slot="footer" />

  <section class="hero wrap">
    <h1>Sriram Nuthi</h1>
    <p class="positioning">
      Associate Software Engineer at <strong>Veeva Systems</strong>. I work on backend storage,
      messaging, and document integration at enterprise scale.
    </p>
    <p class="supporting">
      Archival storage, message queues, and the integrations that move other people&rsquo;s files
      without losing them.
    </p>
    <ProofStrip metrics={metrics} />
  </section>

  <section class="wrap block">
    <SectionHeading id="work" title="Selected work" kicker="01" />
    <div class="card-grid">
      {
        work.map((w) => (
          <WorkCard
            href={`/work/${w.id}`}
            title={w.data.title}
            company={w.data.company}
            summary={w.data.summary}
            metrics={w.data.metrics}
            tech={w.data.tech}
          />
        ))
      }
    </div>
  </section>

  <section class="wrap block">
    <SectionHeading id="experience" title="Experience" kicker="02" />
    <Timeline items={experience} />
  </section>

  <section class="wrap block">
    <SectionHeading id="projects" title="Projects" kicker="03" />
    <div class="card-grid">
      {
        projects.map((p) => (
          <ProjectCard
            title={p.data.title}
            summary={p.data.summary}
            tech={p.data.tech}
            github={p.data.github}
            external={p.data.external}
            personalProject={p.data.personalProject}
          />
        ))
      }
    </div>
  </section>

  <section class="wrap block">
    <SectionHeading id="recognition" title="Recognition" kicker="04" />
    <p class="prose">
      {publicationCount} peer-reviewed publications, including machine-learning research on an
      NIH-granted project at USC. Awards, education, and leadership are listed in full on the
      <a href="/recognition">recognition page</a>.
    </p>
  </section>

  <section class="wrap block">
    <SectionHeading id="writing" title="Writing" kicker="05" />
    <p class="prose">
      I publish on <a href="https://medium.com/@sriramnuthi" rel="me noopener">Medium</a>. Recent
      posts are listed on the <a href="/writing">writing page</a>.
    </p>
  </section>

  <section class="wrap block">
    <SectionHeading id="contact" title="Contact" kicker="06" />
    <p class="prose">
      The fastest way to reach me is email:
      <a href="mailto:sriramnuthi@gmail.com">sriramnuthi@gmail.com</a>. I&rsquo;m also on
      <a href="https://www.linkedin.com/in/sriramnuthi" rel="me noopener">LinkedIn</a> and
      <a href="https://github.com/Nuthi-Sriram" rel="me noopener">GitHub</a>.
    </p>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-5) var(--space-4); }
  h1 { margin: 0 0 var(--space-2); }
  .positioning { margin: 0 0 var(--space-1); font-size: var(--step-1); }
  .supporting { margin: 0; color: var(--text-muted); }
  .block { padding-block: var(--space-5); border-block-start: 1px solid var(--border); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-3);
  }
</style>
