---
interface Props {
  title: string;
  summary: string;
  tech: string[];
  github?: string;
  external?: string;
  personalProject: boolean;
}
const { title, summary, tech, github, external, personalProject } = Astro.props;
const primary = external ?? github;
---

<article class="card">
  <h3>
    {
      primary ? (
        <a href={primary} rel="noopener">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>

  {personalProject && <p class="badge">Personal project</p>}

  <p class="summary">{summary}</p>

  <ul class="tech" aria-label={`Technologies: ${title}`}>
    {tech.map((t) => <li>{t}</li>)}
  </ul>

  {
    github && external && (
      <p class="links">
        <a href={github} rel="noopener">
          Source
        </a>
      </p>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-3);
    background: var(--surface);
    transition: border-color 0.15s ease;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
  }

  h3 {
    margin: 0;
    font-size: var(--step-1);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover,
  h3 a:focus-visible {
    text-decoration: underline;
  }

  /* Labelled in text, not by colour alone. */
  .badge {
    margin: 0;
    max-width: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .summary {
    margin: var(--space-1) 0 var(--space-2);
    max-width: none;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tech li {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .tech li + li::before {
    content: '· ';
  }

  .links {
    margin: var(--space-2) 0 0;
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
