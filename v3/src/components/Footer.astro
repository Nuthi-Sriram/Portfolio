---
const archives = [
  { href: 'https://sriram-nuthi-v2.web.app', label: 'v2 (2023–2026)' },
  { href: 'https://sriram-nuthi-v1.web.app', label: 'v1 (2020–2023)' },
];
---

<footer class="footer">
  <div class="wrap footer-inner">
    <ul class="contact">
      <li><a href="mailto:sriramnuthi@gmail.com">sriramnuthi@gmail.com</a></li>
      <li>
        <a href="https://www.linkedin.com/in/sriramnuthi" rel="me noopener">LinkedIn</a>
      </li>
      <li><a href="https://github.com/Nuthi-Sriram" rel="me noopener">GitHub</a></li>
    </ul>

    <div class="archive">
      <p class="archive-label">Earlier versions of this site</p>
      <ul>
        {
          archives.map((a) => (
            <li>
              {/* nofollow reinforces the noindex header these archives already send,
                  so old versions never compete with this site in search results. */}
              <a href={a.href} rel="nofollow noopener">
                {a.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-6);
    border-block-start: 1px solid var(--border);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .archive-label {
    margin: 0 0 var(--space-1);
    max-width: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  a {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  a:hover,
  a:focus-visible {
    color: var(--text);
  }
</style>
