---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/recognition', label: 'Recognition' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<nav class="nav" aria-label="Primary">
  <div class="wrap nav-inner">
    <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>Sriram Nuthi</a>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="resume" href="/resume.pdf">Resume</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .nav {
    border-block-end: 1px solid var(--border);
    background: var(--bg);
  }
  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }
  .home {
    font-weight: 600;
    text-decoration: none;
  }
  .home:hover,
  .home:focus-visible {
    text-decoration: underline;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--text-muted);
    font-size: var(--step-0);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--text);
    text-decoration: underline;
  }
  /* Current page is marked by weight AND an underline, never colour alone. */
  a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .resume {
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
